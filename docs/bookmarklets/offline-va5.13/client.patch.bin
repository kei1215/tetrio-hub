  };
  loading=load().then(ok=>{
   if(!ok)throw Error('Kugelhagel OVERDRIVE could not be loaded');loaded=true;play();
  }).catch(error=>{failed=true;console.error('[QP reverse HYPERSPEED music]',error)}).finally(()=>{loading=null});
 },clear:game=>stop(game,false)};
})(Sa));reverseMusic.sync(game,on,mods.some(m=>m.includes('_reversed')));
