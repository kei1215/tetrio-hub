 const apply = name => {const item=read().presets.find(entry=>entry.name===name);if(!item)throw Error('保存済み設定「'+name+'」がありません');const available=controls(),byKey=new Map(available.map((node,index)=>[fieldKey(node,index),node]));let changed=0;for(const [id,value] of Object.entries(item.settings?.values||{})){const node=byKey.get(id);if(!node||node.disabled||String(valueOf(node))===String(value))continue;setValue(node,value);changed++}if(!changed)throw Error('変更できる設定がありません。ROOM / MATCH / GAME の設定画面を開いてから実行してください');toast('設定「'+name+'」を'+changed+'項目だけ反映しました。内容を確認して、公式のSAVEを自分で押してください。');};
 const command = raw => {
  const text=String(raw).trim();
  if(/^\/setting(?:\s+(?:help|list))?$/i.test(text)){
   const presets=read().presets.map(item=>item.name);
   const fields=controls().map((node,index)=>node.getAttribute('aria-label')||node.name||node.id||fieldKey(node,index)).slice(0,18);
   toast('ローカル設定コマンド（部屋チャットには送信しません）\n/setting-save 名前  現在の ROOM / MATCH / GAME 設定を保存\n/setting-set 名前   保存設定を反映（ホスト時は公式SAVEも実行）\n/setting-list または /setting  保存済み一覧と検出した設定を表示\n\n保存済み: '+(presets.length?presets.join('、'):'なし')+'\n現在検出: '+(fields.length?fields.join(' / '):'ルーム設定画面を開いてください'));
   return true;
  }
  const match=text.match(/^\/setting-(save|set)(?:\s+(.+))?$/i);if(!match)return false;try{if(match[1].toLowerCase()==='save')save(match[2]);else {if(!match[2])throw Error('/setting-set 名前 の形式で入力してください');apply(match[2].trim())}}catch(error){toast('設定: '+error.message)}return true
