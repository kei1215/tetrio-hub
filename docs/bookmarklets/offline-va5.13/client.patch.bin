 replay(data){
  if(data.version!==undefined&&data.version!==null&&![0,1].includes(data.version))throw Error('このリプレイ形式には対応していません');
  data=B.Update(data);
  const counters=options=>{if(options?.slot_counter3==='pieces'&&options.slot_counter4==='pieces')options.slot_counter4=''};if(data.replay?.options)counters(data.replay.options);for(const round of data.replay?.rounds||[])for(const player of round)counters(player.replay?.options);
  const multi=new B(data).users.length>=2;
  Js.loadReplay(data,{isClientSide:true,back:'play1p'});
  // Keep the native record/results page open. The user explicitly chooses a
  // round or the REPLAY button, matching online replay behavior.
  return multi?'versus':'single';
 },
