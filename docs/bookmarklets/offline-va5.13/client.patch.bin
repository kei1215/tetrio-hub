  else if(mode==='blitz')Js.playBlitz({song:'hyper-velocity'});
  else if(mode==='zen')Js.playZen({});
  else if(mode==='custom')Js.playCustom({song:xt('music_picker_custom').getAttribute('data-song')||'RANDOM'});
