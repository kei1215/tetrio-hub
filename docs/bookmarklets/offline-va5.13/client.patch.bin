 const key = 'tetrio-local-patch:v1';
 const copy = value => JSON.parse(JSON.stringify(value));
 const emptyZen = () => ({map:'_'.repeat(400)+'?',level:1,progress:0,score:0,b2b:0,cycle:1});
 const fresh = () => ({schema:1,selected:null,slots:[],records:[]});
 function load() {
  const raw = storage.getItem(key);
  if (!raw) return fresh();
  const state = JSON.parse(raw);
  if (state.schema !== 1 || !Array.isArray(state.slots) || !Array.isArray(state.records)) throw Error('ローカル保存データの形式に対応していません。上書きせず停止しました。');
  return state;
 }
 function write(state) { storage.setItem(key, JSON.stringify(state)); }
 function selected(state) { return state.slots.find(slot => slot.id === state.selected); }
 const currentScope = () => options.scope?.() === 'online' ? 'online' : 'local';
 function requireAccess(slot) {
  if (!slot) throw Error('ZENの保存枠が選択されていません。');
  if (slot.scope !== currentScope()) throw Error(currentScope()==='online'?'オンラインからオフラインZEN枠へはアクセスできません。':'オフラインからオンラインZEN枠へはアクセスできません。');
 }
 function validZen(data) {
