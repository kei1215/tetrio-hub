  let node=document.getElementById('qp-room-command-toast');
  if(!node){node=document.createElement('div');node.id='qp-room-command-toast';node.style.cssText='position:fixed;z-index:2147483647;right:1em;bottom:1em;max-width:min(42em,92vw);white-space:pre-wrap;padding:.7em 1em;background:#151925ee;color:#eaf4ff;border:1px solid #7297bd;border-radius:.35em;font:14px system-ui;box-shadow:0 .3em 1em #0009';document.body.appendChild(node)}
