   if (scope!==currentScope()) throw Error(currentScope()==='online'?'オンラインではオンライン専用枠だけ作成できます。':'オフラインではローカル枠だけ作成できます。');
   const state=load(), id=options.uuid?.() || crypto.randomUUID();
   const slot={id,name:String(name).trim().slice(0,80)||'ZEN',scope,data:emptyZen(),updatedAt:Date.now()};
   state.slots.push(slot);write(state);return id;
  },
  select(id) {
   if (options.playing?.()) throw Error('プレイを終了してから保存枠を切り替えてください。');
   const state=load();
   if (id!==null) requireAccess(state.slots.find(slot=>slot.id===id));
   state.selected=id;write(state);
  },
