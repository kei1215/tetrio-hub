_GetSpeedrunViewState(){
 const game=this._GetSpeedrunViewGame();
 if(!game||game.isPlaying?.()===false)return 
 const state=game.getZenithSpeedrunState();
 if(game!==this.multiplex.games.self&&game.isSynced&&!game.isSynced()){
  const entry=this._mappedScoreboard.get(game.getOwner());
  if(entry&&typeof entry.speedrun==="boolean"){
   const altitude=entry.stats.altitude,floor=me.GetFloorLevel(altitude);
   const progress=(altitude-me.FloorDistance[floor-1])/(me.FloorDistance[floor]-me.FloorDistance[floor-1]);
   return {...state,state:entry.speedrun?(floor===10?"win":"on"):"off",floor,progress};
  }
 }
 return state;
}
_SyncSpectatorSpeedrunMusic(on){
