  record(mode, result, replay=null) {
   const record={id:options.uuid?.()||crypto.randomUUID(),mode,date:Date.now(),source:'local',result:copy(result),replay:replay===null?null:copy(replay)};if(storage.appendRecord){storage.appendRecord(record);return}const state=load();state.records.push(record);write(state);
  },
  replay(record) {if(record.replay?._localReplayId){if(!storage.readReplay)throw Error('このリプレイの読み込みには更新版パッチが必要です。');return storage.readReplay(record.replay._localReplayId)}return copy(record.replay);},
  deleteRecord(id) {
   if(storage.deleteRecord){storage.deleteRecord(id);return;}
   const state=load();state.records=state.records.filter(record=>record.id!==id);write(state);
  },
  records() { return copy(load().records); },
  export() { const state=load();for(const record of state.records)if(record.replay?._localReplayId)record.replay=storage.readReplay(record.replay._localReplayId);return JSON.stringify(state,null,2); },
 };
